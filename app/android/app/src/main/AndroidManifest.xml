<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">

        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation|density"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:exported="true">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

        </activity>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths"></meta-data>
        </provider>
    </application>

    <!-- Permissions -->

    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Camera: required for CameraSource.Camera (opening the camera) -->
    <uses-permission android:name="android.permission.CAMERA" />

    <!-- Gallery: required for CameraSource.Photos (chooseFromGallery) -->
    <!-- Android 13+ (API 33+) uses the new granular media permission -->
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" />
    <!-- Android 12 and below (API <= 32) use the classic storage permission -->
    <uses-permission
        android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />

    <!-- Geolocation: coarse permission, required as a baseline and as the
         fallback Android grants if the user denies fine location -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <!-- Geolocation: fine permission, required for enableHighAccuracy /
         GPS-level precision in getCurrentPosition and watchPosition -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />

    <!-- Declares the camera as optional hardware: Capacitor's manifest
         merger sometimes marks it as required by default, which blocks
         installation on tablets/emulators without a camera -->
    <uses-feature
        android:name="android.hardware.camera"
        android:required="false" />

    <!-- Declares GPS as optional hardware: same manifest-merger issue as
         the camera — without this, install can be blocked on devices/
         emulators that lack a GPS radio (e.g. Wi-Fi-only tablets) -->
    <uses-feature
        android:name="android.hardware.location.gps"
        android:required="false" />

    <!-- Filesystem: required to read/write files outside the app's private
         sandbox (e.g. Directory.Documents, Directory.ExternalStorage) -->
    <!-- Android 13+ (API 33+) scopes external storage per media type; a
         generic Filesystem write to Documents/ExternalStorage still needs
         the classic permission below on API <= 32 -->
    <uses-permission
        android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />
    <uses-permission
        android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />
</manifest>