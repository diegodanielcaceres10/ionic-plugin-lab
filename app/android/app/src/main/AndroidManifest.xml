<?xml version="1.0" encoding="utf-8" ?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">
        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation|density"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data android:name="android.support.FILE_PROVIDER_PATHS" android:resource="@xml/file_paths" />
        </provider>

        <meta-data android:name="com.google.mlkit.vision.DEPENDENCIES" android:value="barcode_ui" />
    </application>

    <!-- Permissions -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Camera: required for CameraSource.Camera (opening the camera) -->
    <uses-permission android:name="android.permission.CAMERA" />

    <!-- Access to the flashlight (optional, only needed if you use the torch toggle) -->
    <uses-permission android:name="android.permission.FLASHLIGHT" />

    <!-- Gallery: required for CameraSource.Photos (chooseFromGallery) -->
    <!-- Android 13+ (API 33+) uses the new granular media permission -->
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" />
    <!-- Android 12 and below (API <= 32) use the classic storage permission -->
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" android:maxSdkVersion="32" />

    <!-- Geolocation: coarse permission, required as a baseline and as the
         fallback Android grants if the user denies fine location -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <!-- Geolocation: fine permission, required for enableHighAccuracy /
         GPS-level precision in getCurrentPosition and watchPosition -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />

    <!-- Declares the camera as optional hardware: Capacitor's manifest
         merger sometimes marks it as required by default, which blocks
         installation on tablets/emulators without a camera -->
    <uses-feature android:name="android.hardware.camera" android:required="false" />

    <!-- Declares GPS as optional hardware: same manifest-merger issue as
         the camera — without this, install can be blocked on devices/
         emulators that lack a GPS radio (e.g. Wi-Fi-only tablets) -->
    <uses-feature android:name="android.hardware.location.gps" android:required="false" />

    <!-- Filesystem: required to read/write files outside the app's private
         sandbox (e.g. Directory.Documents, Directory.ExternalStorage) -->
    <!-- Android 13+ (API 33+) scopes external storage per media type; a
         generic Filesystem write to Documents/ExternalStorage still needs
         the classic permission below on API <= 32 -->
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" android:maxSdkVersion="32" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" android:maxSdkVersion="32" />

    <!-- Network: required to read connection status (online/offline, wifi/cellular).
         This is a "normal" permission — Android grants it automatically at
         install time, no runtime prompt needed. -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- Local Notifications: required so the runtime permission prompt
         actually works (Android 13+ / API 33+). Without this declared,
         checkPermissions()/requestPermissions() will report the
         notification as blocked even if the user would've allowed it. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Local Notifications: required to fire at the EXACT time you schedule
         (Android 12+ / API 31+). Without it, the OS may delay the
         notification within an inexact ~15 minute window instead — fine for
         reminders, not fine for a "5 seconds from now" demo like this one. -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />

    <!-- Local Notifications: OPTIONAL — only needed if you want notifications
         scheduled before a device reboot to still fire afterwards. Safe to
         skip for this demo since nothing is scheduled far in advance. -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!-- NFC: required to communicate with NFC tags -->
    <uses-permission android:name="android.permission.NFC" />

    <!-- Declares NFC as optional hardware, consistent with how you already
        handle camera/GPS — required="false" allows install on devices/
        emulators without an NFC radio -->
    <uses-feature android:name="android.hardware.nfc" android:required="false" />
</manifest>
